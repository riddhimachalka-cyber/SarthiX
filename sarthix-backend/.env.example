# Environment variables
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500
# Explicit local-only mock mode; production startup rejects LOCAL_MOCK_MODE=true.
LOCAL_MOCK_MODE=false

# Database (Supabase PostgreSQL + pgvector)
# Use Supabase Session Pooler connection string
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
# Alternative individual vars (optional)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
# Server-side only. Never expose this key in frontend code or responses.
GEMINI_API_KEY=
# Separate text-generation model; embeddings remain fixed to gemini-embedding-001.
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Set only for the opt-in vector integration test, using a dedicated non-production database.
# VECTOR_TEST_DATABASE_URL=postgresql://...
